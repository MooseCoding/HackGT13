{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hearth.app/schemas/hcp-weekly-brief.schema.json",
  "title": "HearthWeeklyHcpBrief",
  "description": "Hearth proposed one-screen weekly HCP brief. Decision support only — not an Impiricus vendor format and not a diagnosis.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "patient_id",
    "reporting_period",
    "headline",
    "status",
    "changes",
    "evidence_ids",
    "limitations",
    "suggested_clinician_actions"
  ],
  "properties": {
    "patient_id": {
      "type": "string",
      "pattern": "^P[0-9]{2}$"
    },
    "reporting_period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline_window", "current_window"],
      "properties": {
        "baseline_window": {
          "type": "object",
          "required": ["start", "end"],
          "properties": {
            "start": { "type": "string", "format": "date" },
            "end": { "type": "string", "format": "date" }
          }
        },
        "current_window": {
          "type": "object",
          "required": ["start", "end"],
          "properties": {
            "start": { "type": "string", "format": "date" },
            "end": { "type": "string", "format": "date" }
          }
        }
      }
    },
    "headline": {
      "type": "string",
      "minLength": 12,
      "maxLength": 220,
      "description": "One or two sentences a clinician can scan in under 10 seconds."
    },
    "status": {
      "type": "string",
      "enum": ["stable", "review_suggested"]
    },
    "changes": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "summary"],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "lexical_change",
              "syntax_change",
              "repetition_change",
              "engagement_change",
              "sleep_shift",
              "affect_change",
              "voice_change",
              "none_material"
            ]
          },
          "summary": { "type": "string", "maxLength": 240 },
          "current": { "type": "string" },
          "baseline": { "type": "string" }
        }
      }
    },
    "evidence_ids": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Message IDs from the patient timeline that ground the brief."
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "suggested_clinician_actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "string",
        "enum": [
          "review_evidence",
          "contact_patient_or_caregiver",
          "consider_clinical_screening",
          "document_and_monitor"
        ]
      }
    }
  }
}
