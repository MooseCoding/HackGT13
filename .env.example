# Copy to .env.local. The anon/publishable key is safe for the browser.

NEXT_PUBLIC_SUPABASE_URL=https://nkksroiojqcwwbptplmo.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im5ra3Nyb2lvanFjd3dicHRwbG1vIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTAzNzI3ODcsImV4cCI6MjEwNTk0ODc4N30.DPU_sZLerZ_HyBoB0zsbQzCxfcacs7ur3BVDKZ0MwXg

# Optional. Used for OAuth redirects in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Dedicated Google Calendar OAuth (Connect Google Calendar button).
# Create an OAuth client in Google Cloud; redirect URI must be:
#   http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Optional. Meta Muse for Hestia + Hearth Assistant (https://dev.meta.ai).
# Preferred when set. Get a key at dev.meta.ai → Model API.
MODEL_API_KEY=
AI_MODEL=muse-spark-1.3
AI_API_BASE=https://api.meta.ai/v1

# Optional. Grok fallback when Muse is unavailable. Set AI_PROVIDER_MODE=grok
# during development to exercise the fallback directly.
GROK_API_KEY=
GROK_MODEL=grok-4-fast-reasoning
GROK_API_BASE=https://api.x.ai/v1
AI_PROVIDER_MODE=auto

# Groq is used only for voice transcription.
GROQ_API_KEY=
# Protects the daily clinical analysis endpoint in deployed environments.
CRON_SECRET=

# Optional clinical notification delivery. Without these, the confirmed
# notification action opens a clearly labeled mailto preview and records it.
RESEND_API_KEY=
CLINICAL_EMAIL_FROM=Hearth <reports@YOUR_VERIFIED_DOMAIN>

# WhatsApp Business Cloud API — configure the callback URL as:
# https://YOUR_DOMAIN/api/webhooks/whatsapp
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v23.0
# JSON map of WhatsApp sender numbers to opted-in Hearth member IDs.
# Example: {"14045550123":"elena"}
WHATSAPP_PATIENT_MAP={}
# Optional fallback for the Meta test number during the hackathon.
WHATSAPP_DEFAULT_MEMBER_ID=elena

# Optional voice model override. Uses whisper-large-v3-turbo by default.
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
